__pycache__/
*.pyc
.venv/
.python-version
*.egg-info/

# models — never committed, fetched via models/fetch.sh
models/*.onnx
!models/fetch.sh

# evidence bundles — never committed. A real bundle names the matched post
# and its author in the clear, so there is no committed sample: a stranger's
# post is not ours to publish to illustrate a schema.
evidence/*
!evidence/.gitkeep

# foundry / solidity
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/*/80002/

# zk build artifacts (r1cs, wasm, zkey) — large, regenerable via zk/setup.sh
zk/build/*
!zk/build/.gitkeep

# node (circom/snarkjs tooling)
node_modules/

# local secrets
.env
*.key
consent/*.json
!consent/*.example.json

# OS / editor
.DS_Store
